# 設計案。現行 runner はこれらの変数にまだ対応していません。
# tests/hw/ から uv run --env-file .env ... で明示的に渡します。
# 設備入力は探索用、確定構成は通常の実機試験用です。
OEP_HW_INPUT=./hardware.local.toml
OEP_HW_CONFIG=./hardware.resolved.local.toml
OEP_HW_RESULTS=./.pytest-results
# 同じホストの利用者全員で同じ絶対パスを指定します。
OEP_HW_LOCK=/replace/with/shared/bench.lock
# 実行対象の絞り込みは CLI で指定。個体ごとの配線は TOML に記入。
# TEST_SERIAL_PORT / TEST_SERIAL_PORT_PEER_* は既存 plugin の意味を維持。
