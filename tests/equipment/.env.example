# Copy to .env; load explicitly: uv run --env-file tests/equipment/.env pytest tests/equipment
# No default equipment, no sibling checkout discovery. Stable explicit port or named USB/TCP endpoint.
# serial: independent COBS/CRC inspector, wire fault cases, and same-port close/open retention cases.
# Use client for explicit USB/TCP endpoints (their framing remains the legacy backend).
OEP_CONFORMANCE_FRAMING=serial
OEP_CONFORMANCE_ADDRESS=/absolute/path/to/stable/probe-port
OEP_CONFORMANCE_UNIT_ID=replace-with-unit-id
OEP_CONFORMANCE_SPEC=/absolute/path/to/oep-spec-checkout
OEP_CONFORMANCE_OUT=/absolute/path/to/existing-results-dir/new-core-run.json
OEP_HW_LOCK=/absolute/path/to/existing/shared.lock
# Existing declaration preflight is a separate, narrower contract:
# OEP_HW_CONFIG=/absolute/path/to/hardware.resolved.local.toml
# OEP_HW_RESULTS=/absolute/path/to/results
# Optional verification of the legacy snapshot against its own SPEC_COMMIT, never current HEAD:
# OEP_SPEC_DIR=/absolute/path/to/oep-spec-checkout
